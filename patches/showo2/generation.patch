+"""Low-overhead Linear shape tracing for PTQ kernel preflight.
+
+Enabled through ``FLASHU_SHAPE_TRACE_PATH``.  The tracer records aggregate
+GEMM shapes instead of every invocation so a one-prompt generation run stays
+small enough to inspect and archive.
+"""
+
+from __future__ import annotations
+
+import atexit
+import json
+import math
+import os
+from collections import Counter
+from typing import Dict
+
+import torch
+import torch.nn as nn
+
+
+def _component(name: str) -> str:
+    if name.startswith("showo.model.layers"):
+        if ".mlp." in name:
+            return "qwen_ffn_pruned" if name.endswith("_pruned") else "qwen_ffn_full"
+        if ".self_attn." in name:
+            return "qwen_attention"
+        return "qwen_other"
+    if name.startswith("diffusion_head_a"):
+        return "diffusion_head_a"
+    if name.startswith("diffusion_head_b"):
+        return "diffusion_head_b"
+    if name.startswith("diff_proj"):
+        return "diffusion_projection"
+    if name.startswith("fusion_proj"):
+        return "fusion_projection"
+    if name.startswith("und_trans") or name.startswith("image_embedder_und"):
+        return "understanding_vision"
+    return "other"
+
+
+class LinearShapeTracer:
+    def __init__(self, model: nn.Module, output_path: str):
+        self.model = model
+        self.output_path = output_path
+        self.counts: Counter[str] = Counter()
+        self._handles = []
+        self._flushed = False
+
+        for name, module in model.named_modules():
+            if isinstance(module, nn.Linear):
+                self._handles.append(
+                    module.register_forward_pre_hook(self._make_hook(name, module))
+                )
+        atexit.register(self.flush)
+
+    def _make_hook(self, name: str, module: nn.Linear):
+        def hook(_module, inputs):
+            if not inputs or not torch.is_tensor(inputs[0]):
+                return
+            tensor = inputs[0]
+            if tensor.ndim == 0:
+                return
+            record = {
+                "component": _component(name),
+                "module": name,
+                "input_shape": list(tensor.shape),
+                "M": int(math.prod(tensor.shape[:-1])) if tensor.ndim > 1 else 1,
+                "K": int(tensor.shape[-1]),
+                "N": int(module.out_features),
+                "dtype": str(tensor.dtype).replace("torch.", ""),
+                "step": int(getattr(self.model, "_flashu_current_step", 0)),
+            }
+            self.counts[json.dumps(record, sort_keys=True)] += 1
+
+        return hook
+
+    def flush(self):
+        if self._flushed:
+            return
+        self._flushed = True
+        parent = os.path.dirname(self.output_path)
+        if parent:
+            os.makedirs(parent, exist_ok=True)
+        records = []
+        for encoded, count in self.counts.items():
+            record: Dict[str, object] = json.loads(encoded)
+            record["calls"] = count
+            records.append(record)
+        records.sort(
+            key=lambda item: (
+                item["component"], item["module"], item["step"], item["M"]
+            )
+        )
+        with open(self.output_path, "w", encoding="utf-8") as output_file:
+            json.dump(
+                {
+                    "format": "flashu-linear-shapes-v1",
+                    "unique_records": len(records),
+                    "total_linear_calls": sum(self.counts.values()),
+                    "records": records,
+                },
+                output_file,
+                indent=2,
+                sort_keys=True,
+            )
+
+
+def install_shape_trace(model: nn.Module, output_path: str) -> LinearShapeTracer:
+    """Install one tracer per model and return it."""
+    existing = getattr(model, "_flashu_linear_shape_tracer", None)
+    if existing is not None:
+        return existing
+    tracer = LinearShapeTracer(model, output_path)
+    model._flashu_linear_shape_tracer = tracer
+    return tracer
