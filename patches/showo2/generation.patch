+"""Selective ViDiT-Q W8A8 deployment for Show-o2 Diffusion Head A.
+
+The CUDA kernel produces FP16. To avoid destroying its gain with a cast at
+every Linear, the complete Head A runs in FP16 and crosses the BF16 boundary
+only once on entry and once before Head B. AdaLN and small K/V projections
+remain floating point because their traced shapes are unsupported or slower.
+"""
+
+from __future__ import annotations
+
+import gc
+
+import torch
+import torch.nn as nn
+
+
+class ViDiTQHeadLinear(nn.Module):
+    def __init__(self, linear: nn.Linear):
+        super().__init__()
+        from viditq_extension.nn.qlinear import (
+            W8A8OF16LinearDynamicInputScale,
+        )
+
+        device = linear.weight.device
+        cpu_linear = nn.Linear(
+            linear.in_features,
+            linear.out_features,
+            bias=linear.bias is not None,
+            dtype=torch.float16,
+            device="cpu",
+        )
+        with torch.no_grad():
+            cpu_linear.weight.copy_(linear.weight.detach().cpu().half())
+            if linear.bias is not None:
+                cpu_linear.bias.copy_(linear.bias.detach().cpu().half())
+        self.quant_linear = (
+            W8A8OF16LinearDynamicInputScale.from_linear(
+                cpu_linear, weight_sym=False
+            )
+            .to(device)
+            .eval()
+        )
+        # The upstream asymmetric CUDA entry point always requires a bias
+        # tensor even though its Python module permits ``bias=None``.
+        if self.quant_linear.bias is None:
+            self.quant_linear.bias = nn.Parameter(
+                torch.zeros(
+                    linear.out_features, device=device, dtype=torch.float16
+                ),
+                requires_grad=False,
+            )
+        self.in_features = linear.in_features
+        self.out_features = linear.out_features
+        self._quant_params = {}
+        del cpu_linear
+
+    def _params(self, rows, device):
+        from viditq_extension.nn.base import QuantParams
+
+        key = (rows, device.index)
+        params = self._quant_params.get(key)
+        if params is None:
+            params = QuantParams(rows, has_sum_input=True, device=device)
+            self._quant_params[key] = params
+        return params
+
+    def forward(self, input_tensor):
+        import viditq_extension.fused as fused_kernels
+
+        if input_tensor.dtype != torch.float16:
+            raise TypeError(
+                "ViDiTQHeadLinear expects the Head A FP16 boundary, got "
+                f"{input_tensor.dtype}"
+            )
+        shape = input_tensor.shape
+        flat = input_tensor.reshape(-1, shape[-1]).contiguous()
+        params = self._params(flat.shape[0], flat.device)
+        quantized = fused_kernels.quant_sum(
+            flat, params.sum_input, params.scale_input
+        )
+        output = self.quant_linear(quantized, params)
+        return output.view(*shape[:-1], self.out_features)
+
+
+def _replace_compatible_linears(module, prefix, replaced):
+    for name, child in list(module.named_children()):
+        full_name = f"{prefix}.{name}" if prefix else name
+        if isinstance(child, nn.Linear):
+            compatible = (
+                "adaLN_modulation" not in full_name
+                and child.in_features % 128 == 0
+                and child.out_features % 128 == 0
+                and child.out_features >= 1024
+            )
+            if compatible:
+                setattr(module, name, ViDiTQHeadLinear(child))
+                replaced.append(full_name)
+        else:
+            _replace_compatible_linears(child, full_name, replaced)
+
+
+def apply_viditq_head_w8a8(model):
+    """Quantize only profitable, kernel-compatible Head A Linear modules."""
+    model.diffusion_head_a.half()
+    replaced = []
+    _replace_compatible_linears(
+        model.diffusion_head_a, "diffusion_head_a", replaced
+    )
+    model._flashu_viditq_head_enabled = True
+    model._flashu_viditq_replaced_modules = tuple(replaced)
+    gc.collect()
+    torch.cuda.empty_cache()
+    return replaced
