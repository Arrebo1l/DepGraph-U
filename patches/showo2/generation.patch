+"""Adapter between FlashU's forward-time velocity model and Apple TADA.
+
+FlashU trains the linear path ``x(t) = (1-t) noise + t data`` and predicts
+``dx/dt = data - noise``.  The upstream diffusers-style TADA scheduler uses
+the reverse noise coordinate ``sigma = 1-t`` and expects flow prediction in
+the opposite direction.  Consequently the adapter calls FlashU at
+``t = 1-sigma`` and passes ``-velocity`` to TADA.
+"""
+
+from dataclasses import dataclass
+from typing import Callable
+
+import torch
+
+from third_party.tada.tada_utils.solvers.scheduling_deis_multistep_momentum import (
+    momentumDEISMultistepScheduler,
+)
+from third_party.tada.tada_utils.tada_dynamics import apply_cholesky_transform
+
+
+@dataclass(frozen=True)
+class TADAConfig:
+    """TADA settings for one FlashU evaluation run."""
+
+    nominal_steps: int
+    flow_shift: float = 3.0
+    nd: int = 2
+    k: float = 1.0
+    solver_order: int = 2
+    benchmark: bool = False
+    fast_path: bool = False
+
+    @property
+    def model_evaluations(self) -> int:
+        # FlashU's existing torchdiffeq Euler path receives ``nominal_steps``
+        # time points and therefore makes nominal_steps - 1 model calls.
+        return self.nominal_steps - 1
+
+
+class FlashUTADASampler:
+    """Stateful TADA sampler with the same model-call budget as FlashU Euler."""
+
+    def __init__(self, config: TADAConfig, device: torch.device):
+        if config.nominal_steps < 2:
+            raise ValueError("TADA requires at least two nominal time points")
+        if config.nd < 1:
+            raise ValueError("TADA nd must be positive")
+        if config.solver_order < 2:
+            raise ValueError("The upstream TADA scheduler requires solver_order >= 2")
+
+        self.config = config
+        self.device = torch.device(device)
+        self.scheduler = momentumDEISMultistepScheduler(
+            use_flow_sigmas=True,
+            prediction_type="flow_prediction",
+            flow_shift=config.flow_shift,
+            nd=config.nd,
+            k=config.k,
+            benchmark=int(config.benchmark),
+            solver_order=config.solver_order,
+        )
+        self.scheduler.set_timesteps(
+            config.model_evaluations,
+            device=self.device,
+        )
+        self._fast_prev_force = None
+        self._fast_constants = None
+        if config.fast_path:
+            if not (
+                config.benchmark
+                and config.nd == 2
+                and config.solver_order == 2
+            ):
+                raise ValueError(
+                    "TADA fast path requires benchmark=True, nd=2, order=2"
+                )
+            self._fast_constants = self._precompute_fast_constants()
+
+    def reset(self) -> None:
+        """Reset per-image scheduler state while reusing static DEIS weights."""
+        self.scheduler._step_index = None
+        self.scheduler._begin_index = None
+        self.scheduler._Xs = None
+        self.scheduler.prev_force = [None] * (self.config.solver_order - 1)
+        self.scheduler.lower_order_nums = 0
+        self._fast_prev_force = None
+
+    @torch.no_grad()
+    def _precompute_fast_constants(self) -> dict[str, torch.Tensor]:
+        """Precompute the scalar/matrix terms reused by the fixed N=2 path."""
+        projection_weights = []
+        one_minus_t = []
+        force_scales = []
+        phi_dt = []
+        current_force_coefs = []
+        previous_force_coefs = []
+
+        dyn = self.scheduler.dyn
+        for index in range(self.config.model_evaluations):
+            current_t = self.scheduler.tada_ts[index].reshape(-1).to(
+                device=self.device,
+                dtype=torch.float32,
+            )
+            next_t = self.scheduler.tada_ts[index + 1].reshape(-1).to(
+                device=self.device,
+                dtype=torch.float32,
+            )
+
+            kappa = dyn.tadat_to_kappa(next_t)
+            covariance = dyn.cov_fn(next_t)
+            covariance_inv = torch.linalg.inv(covariance)
+            means = dyn.mean_fn(next_t, 1).to(torch.float32)
+            weights = (covariance_inv @ means.unsqueeze(-1)).squeeze(-1)
+            mean_norm = (weights * means).sum(-1, keepdim=True)
+            signal_scale = self.scheduler.kappa_to_alpha(kappa).reshape(-1, 1)
+            projection_weights.append(
+                (weights / mean_norm * signal_scale).squeeze(0)
+            )
+
+            one_minus = 1.0 - current_t.squeeze(0)
+            one_minus_t.append(one_minus)
+            force_scales.append(2.0 / one_minus.square())
+            phi_dt.append((next_t - current_t).squeeze(0))
+
+            current_coef = self.scheduler.coef[index][0].to(
+                device=self.device,
+                dtype=torch.float32,
+            )
+            current_force_coefs.append(current_coef[:, -1].reshape(-1))
+            if index == 0:
+                previous_force_coefs.append(torch.zeros_like(current_force_coefs[-1]))
+            else:
+                previous_coef = self.scheduler.coef[index][1].to(
+                    device=self.device,
+                    dtype=torch.float32,
+                )
+                previous_force_coefs.append(previous_coef[:, -1].reshape(-1))
+
+        return {
+            "projection_weights": torch.stack(projection_weights),
+            "one_minus_t": torch.stack(one_minus_t),
+            "force_scales": torch.stack(force_scales),
+            "phi_dt": torch.stack(phi_dt),
+            "current_force_coefs": torch.stack(current_force_coefs),
+            "previous_force_coefs": torch.stack(previous_force_coefs),
+        }
+
+    @torch.no_grad()
+    def _fast_step(
+        self,
+        model_output: torch.Tensor,
+        sample: torch.Tensor,
+        step_index: int,
+    ) -> torch.Tensor:
+        """Algebraically equivalent N=2/order=2 benchmark TADA update."""
+        if self.scheduler._Xs is None:
+            self.scheduler._init_Xs(sample)
+            self.scheduler._Xs = self.scheduler._Xs.to(torch.float32)
+
+        constants = self._fast_constants
+        sigma = self.scheduler.sigmas[step_index].to(
+            device=sample.device,
+            dtype=torch.float32,
+        )
+        estimated_data = sample.to(torch.float32) - sigma * model_output.to(
+            torch.float32
+        )
+
+        state = self.scheduler._Xs.reshape(
+            sample.shape[0],
+            2,
+            sample.shape[1],
+            *sample.shape[2:],
+        )
+        one_minus = constants["one_minus_t"][step_index]
+        series_sum = state[:, 0] + one_minus * state[:, 1]
+        force = constants["force_scales"][step_index] * (
+            estimated_data - series_sum
+        )
+
+        spatial_ones = (1,) * (force.ndim - 1)
+        current_coef = constants["current_force_coefs"][step_index].reshape(
+            1, 2, *spatial_ones
+        )
+        multistep_force = force.unsqueeze(1) * current_coef
+        if self._fast_prev_force is not None:
+            previous_coef = constants["previous_force_coefs"][step_index].reshape(
+                1, 2, *spatial_ones
+            )
+            multistep_force = (
+                multistep_force
+                + self._fast_prev_force.unsqueeze(1) * previous_coef
+            )
+
+        dt = constants["phi_dt"][step_index]
+        next_state_0 = state[:, 0] + dt * state[:, 1] + multistep_force[:, 0]
+        next_state_1 = state[:, 1] + multistep_force[:, 1]
+        next_state = torch.stack([next_state_0, next_state_1], dim=1)
+        self.scheduler._Xs = next_state.flatten(start_dim=1, end_dim=2)
+        self._fast_prev_force = force
+
+        if step_index == self.config.model_evaluations - 1:
+            self.scheduler._Xs = None
+            self._fast_prev_force = None
+            return estimated_data
+
+        projection = constants["projection_weights"][step_index]
+        projection = projection.reshape(1, 2, *spatial_ones)
+        return (next_state * projection).sum(dim=1)
+
+    def _init_augmented_latent(
+        self,
+        shape: tuple[int, ...],
+        dtype: torch.dtype,
+    ) -> torch.Tensor:
+        """Sample TADA's augmented state and collapse it to the model input."""
+        batch_size, *spatial_dims = shape
+        nd = self.config.nd
+        kappa0 = self.scheduler.init_kappa().to(self.device)
+        tada_t0 = self.scheduler.dyn.kappa_to_tadat(
+            kappa0,
+            device=self.device,
+        )
+        covariance = self.scheduler.dyn.cov_fn(tada_t0)
+        iid_gaussian = torch.randn(
+            batch_size,
+            nd,
+            *spatial_dims,
+            device=self.device,
+            dtype=covariance.dtype,
+        )
+        augmented = apply_cholesky_transform(
+            iid_gaussian,
+            covariance,
+            nd,
+        ).reshape(batch_size, -1, *spatial_dims[1:])
+        latent, _ = self.scheduler.dyn.prepare_network_input(
+            augmented,
+            tada_t0,
+            kappa_to_mu_fn=self.scheduler.kappa_to_alpha,
+        )
+        self.scheduler._Xs = augmented
+        return latent.to(dtype=dtype)
+
+    def prepare_initial_latent(
+        self,
+        shape: tuple[int, ...],
+        dtype: torch.dtype,
+        duplicate_for_cfg: bool,
+    ) -> torch.Tensor:
+        """Create the initial latent and keep CFG branches exactly paired."""
+        self.reset()
+        if self.config.benchmark:
+            latent = torch.randn(shape, device=self.device, dtype=dtype)
+        else:
+            latent = self._init_augmented_latent(shape, dtype)
+
+        if duplicate_for_cfg:
+            latent = torch.cat([latent, latent], dim=0)
+            if self.scheduler._Xs is not None:
+                self.scheduler._Xs = torch.cat(
+                    [self.scheduler._Xs, self.scheduler._Xs],
+                    dim=0,
+                )
+        return latent
+
+    @torch.no_grad()
+    def sample(
+        self,
+        initial_latent: torch.Tensor,
+        model: Callable,
+        **model_kwargs,
+    ) -> list[torch.Tensor]:
+        """Run TADA and return a one-element history compatible with FlashU."""
+        sample = initial_latent
+        for step_index, timestep in enumerate(self.scheduler.timesteps):
+            sigma = self.scheduler.sigmas[step_index].to(
+                device=sample.device,
+                dtype=torch.float32,
+            )
+            model_time = (1.0 - sigma).expand(sample.shape[0])
+            flashu_velocity = model(sample, model_time, **model_kwargs)
+            tada_flow_prediction = -flashu_velocity
+            if self.config.fast_path:
+                sample = self._fast_step(
+                    tada_flow_prediction,
+                    sample,
+                    step_index,
+                )
+            else:
+                sample = self.scheduler.step(
+                    tada_flow_prediction,
+                    timestep,
+                    sample,
+                ).prev_sample
+
+        if not torch.isfinite(sample).all():
+            raise FloatingPointError("TADA produced NaN or Inf values")
+        return [sample]
